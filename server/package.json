{
  "name": "server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "jest --runInBand"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup/env.js"
    ],
    "globalSetup": "<rootDir>/tests/setup/globalSetup.js",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  },
  "nodemonConfig": {
    "ignore": [
      "tests/*"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "7.0.3",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "jest": "29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "7.1.4"
  }
}
