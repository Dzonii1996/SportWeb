# Primer podešavanja servera. Kopiraj u .env i popuni svoje vrednosti.

PORT=5000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sportweb
DB_USER=postgres
DB_PASSWORD=

# Testovi koriste posebnu bazu (podrazumevano <DB_NAME>_test)
# TEST_DB_NAME=sportweb_test

# Tajni ključ za JWT: dug, nasumičan string
JWT_SECRET=

# Adresa frontenda (linkovi u mejlovima i za deljenje termina)
FRONTEND_URL=http://localhost:3000

# Slanje mejlova (zaboravljena lozinka). Bez SMTP_HOST mejl se samo
# ispisuje u konzolu servera.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=SportWeb <noreply@primer.rs>
