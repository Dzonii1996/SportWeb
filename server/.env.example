# Primer podešavanja servera. Kopiraj u .env i popuni svoje vrednosti.

PORT=5000

# Na hostingu: NODE_ENV=production (tada JWT_SECRET mora imati bar 32 znaka)
# NODE_ENV=production

# PostgreSQL: DATABASE_URL (hosting) ili DB_* promenljive (lokalno)
# DATABASE_URL=postgres://korisnik:lozinka@host:5432/sportweb
# Šifrovana konekcija (Neon, Supabase, spoljna konekcija na Render)
# DB_SSL=true
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sportweb
DB_USER=postgres
DB_PASSWORD=

# Testovi koriste posebnu bazu (podrazumevano <DB_NAME>_test)
# TEST_DB_NAME=sportweb_test

# Vremenska zona termina (baza i server); podrazumevano Europe/Belgrade
# APP_TIMEZONE=Europe/Belgrade

# Tajni ključ za JWT: dug, nasumičan string (u produkciji bar 32 znaka), npr.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Admini (dodaju terene i odobravaju predloge): emailovi odvojeni zarezom.
# Admin može da se postavi i u bazi: UPDATE users SET is_admin = true WHERE email = '...';
# ADMIN_EMAILS=ja@primer.rs

# Adresa frontenda (linkovi u mejlovima i za deljenje termina)
FRONTEND_URL=http://localhost:3000

# Na hostingu iza proxy-ja: broj proxy-ja ispred servera (obično 1). Lokalno ne treba.
# TRUST_PROXY=1

# Samo sa ove adrese browser sme da šalje zahteve serveru (CORS). Dodatne adrese,
# npr. sa www, odvojene zarezom:
# CORS_ORIGINS=https://www.primer.rs

# Slanje mejlova (zaboravljena lozinka). Bez SMTP_HOST mejl se samo
# ispisuje u konzolu servera.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=SportWeb <noreply@primer.rs>

# Push obaveštenja na telefonu (instalirana web aplikacija). Ključeve napravi jednom:
#   npx web-push generate-vapid-keys
# Bez njih push se ne šalje, a obaveštenja u aplikaciji rade kao i do sada.
# VAPID_SUBJECT je https adresa sajta ili mailto: adresa (podrazumevano FRONTEND_URL ako je https).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ja@primer.rs
